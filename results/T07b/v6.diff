+    fold_challenges = HeapBuf(GEN ** n_folds)
+    level_betas = HeapBuf(GEN ** n_levels)
+    level_mus = HeapBuf(GEN ** n_levels)
+    query_positions = HeapBuf(GEN ** (LIG_POSITIONS_LEN[m_idx]))
+    query_win_ptrs = HeapBuf(GEN ** (LIG_POSITIONS_LEN[m_idx]))
