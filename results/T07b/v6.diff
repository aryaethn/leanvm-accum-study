+                ood_y = sample[GEN ** OOD_Y]
+                ood_c2 = sample[GEN ** OOD_C2]
+                sample[GEN ** OOD_BETA] = ood_scalar
+                round_quad_c += ood_scalar * sample[GEN ** OOD_C0]
+                round_quad_b += ood_scalar * (ood_y + ood_c2)
+                round_quad_a += ood_scalar * ood_c2
