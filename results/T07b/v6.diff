+    lqs = v6_opening_queries_free(lam, lam_pow, share[GEN ** V6_WINS], share[GEN ** V6_ROWEQ], GEN ** LIG_QUERIES[ml1], LIG_INTERLEAVE[ml1], LIG_LEAF_CELLS[ml1], LIG_TREE_DEPTH[ml1], LIG_CAP_DEPTH[ml1])
